---
import SiteLayout from "../layouts/SiteLayout.astro";

const actions = [
  { href: "/blog/", label: "Read the blog" },
  { href: "/guides/", label: "Explore community guides" },
];
---

<SiteLayout>
  <section class="hero">
    <p class="eyebrow">Static clarity. Community continuity.</p>
    <h1>DiscussionBridge</h1>
    <p class="hero__lead">
      Publish from Astro. Discuss in Discourse. Keep source-controlled content connected to the
      people, questions, and working knowledge that continue after a page ships.
    </p>
    <div class="actions">
      {actions.map((action, index) => (
        <a class:list={["button", { secondary: index > 0 }]} href={action.href}>{action.label}</a>
      ))}
    </div>
  </section>

  <section class="statement" aria-labelledby="working-loop">
    <h2 id="working-loop">A two-way publishing loop</h2>
    <p>
      The site starts conversations. The community develops durable knowledge.
      The site publishes what the community learns.
    </p>
  </section>

  <section class="lanes" aria-label="DiscussionBridge product lanes">
    <article>
      <p class="eyebrow">Astro to Discourse</p>
      <h2>Start the conversation</h2>
      <p>Publish a source-controlled page and give its readers a clear, purpose-specific place to discuss it.</p>
      <a href="/blog/every-connection-has-a-job/">See the live blog lane</a>
    </article>
    <article>
      <p class="eyebrow">Discourse to Astro</p>
      <h2>Preserve what the community learns</h2>
      <p>Develop a wiki or how-to in the community, then publish the reviewed source as a durable site guide.</p>
      <a href="/guides/">See the community guide lane</a>
    </article>
    <article>
      <p class="eyebrow">Operate with confidence</p>
      <h2>Know what owns the source</h2>
      <p>Use diagnostics, explicit source modes, no-writeback protection, and recoverable target-specific sync.</p>
      <a href="https://docs.discussionbridge.dev/">Read the documentation</a>
    </article>
  </section>
</SiteLayout>

<style>
  .hero {
    max-width: 900px;
    padding-block: 24px 52px;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 11vw, 7rem);
  }

  .hero__lead {
    max-width: 820px;
    margin: 20px 0 28px;
    color: var(--muted);
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 9px 14px;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .button:hover {
    color: #fff;
    background: var(--accent-strong);
  }

  .button.secondary {
    color: var(--accent-strong);
    background: transparent;
  }

  .button.secondary:hover {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  .statement {
    padding-block: 34px;
    border-block: 1px solid var(--line);
  }

  .statement h2 {
    margin: 0 0 8px;
    font-size: 1.15rem;
  }

  .statement p {
    max-width: 900px;
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.6rem);
    line-height: 1.25;
  }

  .lanes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    padding-block-start: 42px;
  }

  .lanes article {
    min-width: 0;
  }

  .lanes h2 {
    margin: 0 0 10px;
    font-size: 1.35rem;
  }

  .lanes p:not(.eyebrow) {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .lanes {
      grid-template-columns: 1fr;
    }
  }
</style>
