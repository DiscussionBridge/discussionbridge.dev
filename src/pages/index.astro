---
import SiteLayout from "../layouts/SiteLayout.astro";

const actions = [
  { href: "https://demo.discussionbridge.dev/", label: "Explore live demos" },
  { href: "https://bridge.demo.discussionbridge.dev/", label: "Visit The Bridge" },
  { href: "/roadmap/", label: "View the roadmap" },
];

const alphaProfiles = [
  "Astro",
  "Ghost",
  "Hugo",
  "Statamic DB",
  "Statamic Flat",
  "WordPress",
  "The Bridge — Discourse as Publisher",
];
---

<SiteLayout description="DiscussionBridge is a product family for publishing anywhere while keeping one durable Discourse discussion.">
  <section class="hero">
    <p class="eyebrow">Publish anywhere. Keep the discussion.</p>
    <h1>DiscussionBridge</h1>
    <p class="hero__lead">
      A family of tools that keeps discussion independent of the publishing platform.
      Connect content by choice, change platforms without abandoning community history,
      and keep Discourse as the durable discussion home.
    </p>
    <div class="actions">
      {actions.map((action, index) => (
        <a class:list={["button", { secondary: index > 0 }]} href={action.href}>{action.label}</a>
      ))}
    </div>
  </section>

  <section class="statement" aria-labelledby="continuity-statement">
    <p class="eyebrow">The product promise</p>
    <h2 id="continuity-statement">Your platform may change. Your discussion continues.</h2>
    <p>
      One canonical discussion can appear wherever its content belongs. Disconnecting a CMS,
      replacing a theme, or moving to another framework does not erase the conversation.
    </p>
  </section>

  <section class="family" aria-labelledby="family-heading">
    <div class="section-intro">
      <p class="eyebrow">The product family</p>
      <h2 id="family-heading">One purpose, several focused tools.</h2>
      <p>DiscussionBridge is the family. These are the first products and capabilities taking shape.</p>
    </div>
    <div class="family-grid">
      <article class="featured">
        <p class="eyebrow">Flagship</p>
        <h3>The Bridge</h3>
        <p>The Discourse-powered flagship and reference experience where durable discussions, Content Connections, Bridge Records, presentation, reconciliation, and authorship come together.</p>
        <a href="https://bridge.demo.discussionbridge.dev/">Open The Bridge</a>
      </article>
      <article>
        <p class="eyebrow">Inaugural platform product</p>
        <h3>DiscussionBridge for Astro + Starlight</h3>
        <p>Useful with standard Discourse on its own, then enhanced by the optional DiscussionBridge plugin without replacing the Astro product or its existing discussions.</p>
        <a href="https://astrostarlight.demo.discussionbridge.dev/">See Astro + Starlight</a>
      </article>
      <article>
        <p class="eyebrow">Focused capabilities</p>
        <h3>Content first, extensions by purpose.</h3>
        <p>Network, Migration, Identity, and Deployment remain distinct capabilities so the core plugin does not become an unrelated all-in-one control system.</p>
        <a href="/roadmap/">See what comes next</a>
      </article>
    </div>
  </section>

  <section class="alpha" aria-labelledby="alpha-heading">
    <div>
      <p class="eyebrow">Alpha path</p>
      <h2 id="alpha-heading">Seven real publishing profiles.</h2>
      <p>Alpha is built around meaningful source content, stable discussion identity, native presentation, safe retry, and honest live demonstrations.</p>
    </div>
    <ol>
      {alphaProfiles.map((profile, index) => (
        <li><strong>{String(index + 1).padStart(2, "0")}</strong><span>{profile}</span></li>
      ))}
    </ol>
  </section>

  <section class="invitation" aria-labelledby="invitation-heading">
    <p class="eyebrow">Help shape what follows</p>
    <h2 id="invitation-heading">What should DiscussionBridge connect next?</h2>
    <p>Future adapters and capabilities should answer real publishing needs. Bring us a platform, migration, identity, or network workflow worth solving.</p>
    <div class="actions">
      <a class="button" href="https://forum.discussionbridge.dev/">Join the discussion</a>
      <a class="button secondary" href="/roadmap/">Read the public roadmap</a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { max-width: 930px; padding-block: 28px 58px; }
  h1 { margin: 0; font-size: clamp(3.2rem, 11vw, 7rem); }
  .hero__lead { max-width: 860px; margin: 20px 0 28px; color: var(--muted); font-size: clamp(1.15rem, 2.4vw, 1.55rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .button { display: inline-flex; min-height: 44px; align-items: center; padding: 9px 14px; border: 1px solid var(--accent); border-radius: 6px; background: var(--accent); color: #fff; font-weight: 700; text-decoration: none; }
  .button:hover { color: #fff; background: var(--accent-strong); }
  .button.secondary { color: var(--accent-strong); background: transparent; }
  .button.secondary:hover { color: var(--accent-strong); background: var(--accent-soft); }
  .statement { padding-block: 42px; border-block: 1px solid var(--line); }
  .statement h2, .section-intro h2, .alpha h2, .invitation h2 { margin: 0; font-size: clamp(1.9rem, 4vw, 3.2rem); }
  .statement > p:last-child { max-width: 900px; margin: 14px 0 0; color: var(--muted); font-size: 1.1rem; }
  .family { padding-block: 56px; }
  .section-intro { max-width: 800px; margin-bottom: 24px; }
  .section-intro > p:last-child { color: var(--muted); }
  .family-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .family-grid article { display: flex; min-height: 315px; flex-direction: column; padding: 28px; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); }
  .family-grid article.featured { background: #12343a; color: #fff; }
  .family-grid article.featured .eyebrow, .family-grid article.featured a { color: #a6e0da; }
  .family-grid article.featured p:not(.eyebrow) { color: #d1e0e1; }
  .family-grid h3 { margin: 0; font-size: 1.55rem; }
  .family-grid p:not(.eyebrow) { color: var(--muted); }
  .family-grid a { margin-top: auto; font-weight: 750; }
  .alpha { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr); gap: 48px; padding: 46px; border-radius: 22px; background: var(--accent-soft); }
  .alpha > div > p:last-child { color: var(--muted); }
  .alpha ol { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .alpha li { display: grid; grid-template-columns: 38px 1fr; gap: 10px; padding: 9px 0; border-bottom: 1px solid #c9e2e6; font-weight: 700; }
  .alpha li:last-child { border-bottom: 0; }
  .alpha li strong { color: var(--accent-strong); font-size: 0.78rem; letter-spacing: 0.08em; }
  .invitation { margin-top: 56px; padding: 40px 0 10px; border-top: 1px solid var(--line); }
  .invitation > p:not(.eyebrow) { max-width: 780px; color: var(--muted); font-size: 1.08rem; }
  @media (max-width: 800px) { .family-grid, .alpha { grid-template-columns: 1fr; } .alpha { padding: 28px; } }
</style>
